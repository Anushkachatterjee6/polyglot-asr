# Optional local JSON file created by ml/evaluation/evaluate.py.
POLYGLOT_EVALUATION_PATH=data/evaluation.json
# Comma separated frontend origins. Do not include credentials or API keys.
POLYGLOT_CORS_ORIGINS=http://127.0.0.1:5175
# Directory for the small local SQLite history database (not shared storage).
POLYGLOT_DATA_DIR=data
# Required for Gemini 3.5 Transcribe. Put the real value only in ignored backend/.env.
GEMINI_API_KEY=
# Optional request deadline in seconds (10-90). The default is 60.
GEMINI_TIMEOUT_SECONDS=60
# Maximum total duration for one benchmark run in seconds (30-1800).
EVALUATION_TIMEOUT_SECONDS=300
# Leave false to avoid an inherited system proxy. Set true only when a working proxy is required.
GEMINI_USE_ENV_PROXY=false
