# Absolute path to a directory saved with `ml.training.train`.
POLYGLOT_MODEL_PATH=
# Optional local JSON file created by ml/evaluation/evaluate.py.
POLYGLOT_EVALUATION_PATH=data/evaluation.json
# Comma separated frontend origins. Do not include credentials or API keys.
POLYGLOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8082,http://127.0.0.1:8082
# Directory for the small local SQLite history database (not shared storage).
POLYGLOT_DATA_DIR=data
